{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@stillmap-examples/basic",
	"version": "0.0.0",
	"private": true,
	"license": "Apache-2.0",
	"author": {
		"name": "abi group GmbH",
		"email": "info@abigroup.io",
		"url": "https://abigroup.io"
	},
	"type": "module",
	"scripts": {
		"dev": "stillmap dev maps",
		"format:check": "prettier --check '{{maps,src,test}/**/*,*}.{{t,j}s{,x},json{,5},md,y{,a}ml}'",
		"format:fix": "prettier --write '{{maps,src,test}/**/*,*}.{{t,j}s{,x},json{,5},md,y{,a}ml}'",
		"lint:check": "eslint '{{maps,src,test}/**/*,*}.{t,j}s{,x}'",
		"lint:fix": "eslint '{{maps,src,test}/**/*,*}.{t,j}s{,x}' --fix",
		"start": "tsx src/main.ts",
		"test-unit": "vitest --run --config vitest.config.ts --project='*#unit'",
		"test-unit:watch": "vitest --config vitest.config.ts --project='*#unit'",
		"typecheck": "tsc -p tsconfig.json"
	},
	"lint-staged": {
		"{{maps,src,test}/**/*,*}.{{t,j}s{,x},json{,5},md,y{,a}ml}": "prettier --write",
		"{{maps,src,test}/**/*,*}.{t,j}s{,x}": "eslint --fix"
	},
	"prettier": "@abinnovision/prettier-config",
	"dependencies": {
		"@stillmap/react": "workspace:^",
		"@stillmap/sources": "workspace:^"
	},
	"devDependencies": {
		"@abinnovision/eslint-config-base": "^3.4.2",
		"@abinnovision/prettier-config": "^2.2.0",
		"@internal/tsconfig": "workspace:*",
		"@resvg/resvg-js": "^2.6.2",
		"@stillmap/core": "workspace:^",
		"@types/node": "^26.4.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"eslint": "^10.7.0",
		"prettier": "^3.9.5",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"stillmap": "workspace:^",
		"tsx": "^4.20.6",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	}
}
