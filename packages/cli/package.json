{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "stillmap",
	"version": "0.1.0",
	"description": "CLI for stillmap. Previews map templates in the browser.",
	"keywords": [
		"map",
		"static-map",
		"cli"
	],
	"homepage": "https://github.com/abinnovision/stillmap",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/abinnovision/stillmap.git",
		"directory": "packages/cli"
	},
	"license": "Apache-2.0",
	"author": {
		"name": "abi group GmbH",
		"email": "info@abigroup.io",
		"url": "https://abigroup.io"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"development": "./src/index.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"bin": "./dist/cli.js",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc --build tsconfig.build.json",
		"format:check": "prettier --check '{{src,test}/**/*,*}.{{t,j}s{,x},json{,5},md,y{,a}ml}'",
		"format:fix": "prettier --write '{{src,test}/**/*,*}.{{t,j}s{,x},json{,5},md,y{,a}ml}'",
		"lint:check": "eslint '{{src,test}/**/*,*}.{t,j}s{,x}'",
		"lint:fix": "eslint '{{src,test}/**/*,*}.{t,j}s{,x}' --fix",
		"test-integration": "vitest --run --config vitest.integration.config.ts --project='*#integration'",
		"test-unit": "vitest --run --coverage --config vitest.config.ts --project='*#unit'",
		"test-unit:watch": "vitest --config vitest.config.ts --project='*#unit'",
		"typecheck": "tsc -p tsconfig.json"
	},
	"lint-staged": {
		"{{src,test}/**/*,*}.{{t,j}s{,x},json{,5},md,y{,a}ml}": "prettier --write",
		"{{src,test}/**/*,*}.{t,j}s{,x}": "eslint --fix"
	},
	"prettier": "@abinnovision/prettier-config",
	"dependencies": {
		"esbuild": "^0.28.2"
	},
	"devDependencies": {
		"@abinnovision/eslint-config-base": "^3.4.2",
		"@abinnovision/eslint-config-react": "^4.0.0",
		"@abinnovision/prettier-config": "^2.2.0",
		"@internal/tsconfig": "workspace:*",
		"@stillmap/core": "workspace:^",
		"@stillmap/react": "workspace:^",
		"@stillmap/sources": "workspace:^",
		"@types/node": "^26.4.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^10.7.0",
		"prettier": "^3.9.5",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"@stillmap/core": "workspace:^",
		"@stillmap/react": "workspace:^",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"npm": true,
		"npmAccess": "public"
	}
}
