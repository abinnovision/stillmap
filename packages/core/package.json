{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@stillmap/core",
	"version": "0.2.0",
	"description": "Server-side vector map rendering engine. No React, no native dependencies.",
	"keywords": [
		"map",
		"vector-tile",
		"mvt",
		"svg",
		"static-map"
	],
	"homepage": "https://github.com/abinnovision/stillmap",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/abinnovision/stillmap.git",
		"directory": "packages/core"
	},
	"license": "Apache-2.0",
	"author": {
		"name": "abi group GmbH",
		"email": "info@abigroup.io",
		"url": "https://abigroup.io"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc --build tsconfig.build.json",
		"format:check": "prettier --check '{{src,test}/**/*,*}.{{t,j}s{,x},json{,5},md,y{,a}ml}'",
		"format:fix": "prettier --write '{{src,test}/**/*,*}.{{t,j}s{,x},json{,5},md,y{,a}ml}'",
		"lint:check": "eslint '{{src,test}/**/*,*}.{t,j}s{,x}'",
		"lint:fix": "eslint '{{src,test}/**/*,*}.{t,j}s{,x}' --fix",
		"test-integration": "vitest --run --config vitest.integration.config.ts --project='*#integration'",
		"test-unit": "vitest --run --coverage --config vitest.config.ts --project='*#unit'",
		"test-unit:watch": "vitest --config vitest.config.ts --project='*#unit'",
		"typecheck": "tsc -p tsconfig.json"
	},
	"lint-staged": {
		"{{src,test}/**/*,*}.{{t,j}s{,x},json{,5},md,y{,a}ml}": "prettier --write",
		"{{src,test}/**/*,*}.{t,j}s{,x}": "eslint --fix"
	},
	"prettier": "@abinnovision/prettier-config",
	"dependencies": {
		"@mapbox/vector-tile": "^3.0.0",
		"opentype.js": "^2.0.0",
		"pbf": "^5.1.2"
	},
	"devDependencies": {
		"@abinnovision/eslint-config-base": "^3.4.2",
		"@abinnovision/prettier-config": "^2.2.0",
		"@internal/tsconfig": "workspace:*",
		"@resvg/resvg-js": "^2.6.2",
		"@types/mapbox__vector-tile": "^2.0.0",
		"@types/node": "^26.4.0",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^10.7.0",
		"prettier": "^3.9.5",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"@resvg/resvg-js": "^2.6.2"
	},
	"peerDependenciesMeta": {
		"@resvg/resvg-js": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"npm": true,
		"npmAccess": "public"
	}
}
