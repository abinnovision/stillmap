{
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
	"changelog-path": "CHANGELOG.md",
	"release-type": "node",
	"initial-version": "0.1.0",
	"bump-minor-pre-major": true,
	"bump-patch-for-minor-pre-major": true,
	"separate-pull-requests": false,
	"plugins": [
		{
			"type": "linked-versions",
			"groupName": "stillmap",
			"components": ["core", "sources", "react", "serve", "styles", "cli"]
		}
	],
	"packages": {
		"packages/core": { "component": "core" },
		"packages/sources": { "component": "sources" },
		"packages/react": { "component": "react" },
		"packages/serve": { "component": "serve" },
		"packages/styles": { "component": "styles" },
		"packages/cli": { "component": "cli" }
	}
}
